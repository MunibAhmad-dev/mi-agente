                            <div class="card-body">
                                <div class="status-item"><span class="name">Total Memories</span><span class="value">2,847</span></div>
                                <div class="status-item"><span class="name">Recall Operations</span><span class="value">15,234</span></div>
                                <div class="status-item"><span class="name">Consolidations</span><span class="value">456</span></div>
                                <div class="status-item"><span class="name">Lessons Learned</span><span class="value">156</span></div>
                                <div class="status-item"><span class="name">Avg Recall Time</span><span class="value">12ms</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ═══ RAG ═══ -->
                <div id="rag" class="section">
                    <h2 style="margin-bottom: 20px;">RAG System</h2>
                    <div class="grid-2">
                        <div class="card">
                            <div class="card-header"><h3><i class="fas fa-layer-group" style="color: var(--accent-light)"></i> RAG Components</h3></div>
                            <div class="card-body">
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Smart Chunker</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Semantic Compressor</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Vector Store</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">BM25 Search</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Hybrid Search</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Adaptive RAG</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Contextual Retriever</span></div><span class="tag green">Active</span></div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header"><h3><i class="fas fa-chart-line" style="color: var(--success)"></i> RAG Stats</h3></div>
                            <div class="card-body">
                                <div class="status-item"><span class="name">Documents Ingested</span><span class="value">1,234</span></div>
                                <div class="status-item"><span class="name">Total Chunks</span><span class="value">15,678</span></div>
                                <div class="status-item"><span class="name">Retrievals</span><span class="value">8,901</span></div>
                                <div class="status-item"><span class="name">Avg Retrieval Time</span><span class="value">45ms</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ═══ AGENTS ═══ -->
                <div id="agents" class="section">
                    <h2 style="margin-bottom: 20px;">Sub-Agents</h2>
                    <div class="card">
                        <div class="card-header"><h3><i class="fas fa-robot" style="color: var(--accent-light)"></i> Available Agents</h3></div>
                        <div class="card-body">
                            <table>
                                <tr><th>Agent</th><th>Type</th><th>Status</th><th>Tasks</th><th>Actions</th></tr>
                                <tr><td>Code Reviewer</td><td><span class="tag purple">Specialized</span></td><td><span class="tag green">Ready</span></td><td>234</td><td><button class="btn btn-sm btn-secondary" onclick="showToast('info', 'Launching Code Reviewer...')">Launch</button></td></tr>
                                <tr><td>Debugger</td><td><span class="tag purple">Specialized</span></td><td><span class="tag green">Ready</span></td><td>156</td><td><button class="btn btn-sm btn-secondary" onclick="showToast('info', 'Launching Debugger...')">Launch</button></td></tr>
                                <tr><td>Test Writer</td><td><span class="tag purple">Specialized</span></td><td><span class="tag green">Ready</span></td><td>89</td><td><button class="btn btn-sm btn-secondary" onclick="showToast('info', 'Launching Test Writer...')">Launch</button></td></tr>
                                <tr><td>Security Auditor</td><td><span class="tag purple">Specialized</span></td><td><span class="tag green">Ready</span></td><td>67</td><td><button class="btn btn-sm btn-secondary" onclick="showToast('info', 'Launching Security Auditor...')">Launch</button></td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ═══ SECURITY ═══ -->
                <div id="security" class="section">
                    <h2 style="margin-bottom: 20px;">Security</h2>
                    <div class="grid-2">
                        <div class="card">
                            <div class="card-header"><h3><i class="fas fa-shield-alt" style="color: var(--success)"></i> Security Features</h3></div>
                            <div class="card-body">
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Docker Sandbox</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Approval Gates</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Credential Vault</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Audit Logging</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Agent Firewall</span></div><span class="tag green">Active</span></div>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header"><h3><i class="fas fa-chart-bar" style="color: var(--info)"></i> Security Stats</h3></div>
                            <div class="card-body">
                                <div class="status-item"><span class="name">Blocked Commands</span><span class="value">45</span></div>
                                <div class="status-item"><span class="name">Approval Requests</span><span class="value">234</span></div>
                                <div class="status-item"><span class="name">Audit Events</span><span class="value">12,456</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ═══ MONITORING ═══ -->
                <div id="monitoring" class="section">
                    <h2 style="margin-bottom: 20px;">System Monitoring</h2>
                    <div class="stats-grid">
                        <div class="stat-card"><div class="icon green"><i class="fas fa-microchip"></i></div><div class="label">CPU</div><div class="value">15%</div><div class="progress-bar"><div class="progress-fill green" style="width: 15%"></div></div></div>
                        <div class="stat-card"><div class="icon blue"><i class="fas fa-memory"></i></div><div class="label">RAM</div><div class="value">950MB</div><div class="progress-bar"><div class="progress-fill blue" style="width: 6%"></div></div></div>
                        <div class="stat-card"><div class="icon purple"><i class="fas fa-hdd"></i></div><div class="label">Disk</div><div class="value">200MB</div><div class="progress-bar"><div class="progress-fill purple" style="width: 2%"></div></div></div>
                        <div class="stat-card"><div class="icon orange"><i class="fas fa-network-wired"></i></div><div class="label">Network</div><div class="value">Active</div></div>
                    </div>
                </div>

                <!-- ═══ SETTINGS ═══ -->
                <div id="settings" class="section">
                    <h2 style="margin-bottom: 20px;">Settings</h2>
                    <div class="card">
                        <div class="card-header"><h3><i class="fas fa-cog" style="color: var(--accent-light)"></i> System Configuration</h3></div>
                        <div class="card-body">
                            <div class="status-item"><span class="name">Max Iterations</span><span class="value">20</span></div>
                            <div class="status-item"><span class="name">Max Retries</span><span class="value">3</span></div>
                            <div class="status-item"><span class="name">Timeout</span><span class="value">300s</span></div>
                            <div class="status-item"><span class="name">Self-healing</span><span class="tag green">Enabled</span></div>
                            <div class="status-item"><span class="name">Auto-checkpoint</span><span class="tag green">Enabled</span></div>
                            <div class="status-item"><span class="name">Tool Compression</span><span class="tag green">Enabled</span></div>
                        </div>
                    </div>
                </div>

                <!-- Placeholder sections -->
                <div id="routing" class="section"><h2>Intelligent Routing</h2><p style="color: var(--text-secondary); margin-top: 16px;">Model routing based on task complexity, cost, and performance.</p></div>
                <div id="pipelines" class="section"><h2>Model Pipelines</h2><p style="color: var(--text-secondary); margin-top: 16px;">Sequential, parallel, fallback, and voting pipelines.</p></div>
                <div id="knowledge" class="section"><h2>Knowledge Graph</h2><p style="color: var(--text-secondary); margin-top: 16px;">Causal relationships between concepts.</p></div>
                <div id="browser" class="section"><h2>Browser Engine</h2><p style="color: var(--text-secondary); margin-top: 16px;">Playwright-based browser automation.</p></div>
                <div id="terminal" class="section"><h2>Terminal</h2><p style="color: var(--text-secondary); margin-top: 16px;">Shell command execution.</p></div>
                <div id="workflows" class="section"><h2>Workflows</h2><p style="color: var(--text-secondary); margin-top: 16px;">Dynamic workflow engine.</p></div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Modal: Tool Info -->
    <div class="modal-overlay" id="toolInfoModal">
        <div class="modal">
            <div class="modal-header">
                <h3>Tool Information</h3>
                <button class="modal-close" onclick="closeModal('toolInfoModal')"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <p style="color: var(--text-secondary); margin-bottom: 16px;">Click on any tool to see details.</p>
                <div class="status-item"><span class="name">Total Tools</span><span class="value">54</span></div>
                <div class="status-item"><span class="name">Core Tools</span><span class="value">13</span></div>
                <div class="status-item"><span class="name">Cognitive Modules</span><span class="value">58</span></div>
                <div class="status-item"><span class="name">Verification</span><span class="value">2</span></div>
            </div>
        </div>
    </div>

    <!-- Modal: Settings -->
    <div class="modal-overlay" id="settingsModal">
        <div class="modal">
            <div class="modal-header">
                <h3>Quick Settings</h3>
                <button class="modal-close" onclick="closeModal('settingsModal')"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <div class="status-item"><span class="name">Max Iterations</span><span class="value">20</span></div>
                <div class="status-item"><span class="name">Self-healing</span><span class="tag green">Enabled</span></div>
                <div class="status-item"><span class="name">Auto-checkpoint</span><span class="tag green">Enabled</span></div>
            </div>
        </div>
    </div>

    <script>
        // ── Navigation ──────────────────────────────────
        const titles = {
            overview: 'Overview', chat: 'Chat', agents: 'Agents', models: 'Models',
            routing: 'Intelligent Routing', pipelines: 'Model Pipelines', memory: 'Memory',
            rag: 'RAG System', knowledge: 'Knowledge Graph', tools: 'Tools',
            browser: 'Browser Engine', terminal: 'Terminal', workflows: 'Workflows',
            security: 'Security', monitoring: 'Monitoring', settings: 'Settings'
        };

        function showSection(name) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            const section = document.getElementById(name);
            if (section) section.classList.add('active');
            event.currentTarget.classList.add('active');
            document.getElementById('pageTitle').textContent = titles[name] || name;
            document.getElementById('pageBreadcrumb').textContent = `Dashboard / ${titles[name] || name}`;
        }

        // ── Toast Notifications ─────────────────────────
        function showToast(type, message) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast';
            const icons = { success: 'check-circle', error: 'times-circle', info: 'info-circle', warning: 'exclamation-triangle' };
            const colors = { success: 'var(--success)', error: 'var(--danger)', info: 'var(--info)', warning: 'var(--warning)' };
            toast.innerHTML = `<i class="fas fa-${icons[type]}" style="color: ${colors[type]}; font-size: 16px;"></i><span style="font-size: 13px;">${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3500);
        }

        // ── Modal ───────────────────────────────────────
        function openModal(id) { document.getElementById(id).classList.add('active'); }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }
        document.querySelectorAll('.modal-overlay').forEach(m => {
            m.addEventListener('click', e => { if (e.target === m) m.classList.remove('active'); });
        });

        // ── Chat ────────────────────────────────────────
        function sendMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            if (!message) return;
            
            const messagesDiv = document.getElementById('chatMessages');
            messagesDiv.innerHTML += `<div class="message user"><div class="avatar"><i class="fas fa-user"></i></div><div><div class="bubble">${message}</div></div></div>`;
            input.value = '';
            
            // Typing indicator
            const typingId = 'typing-' + Date.now();
            messagesDiv.innerHTML += `<div class="message assistant" id="${typingId}"><div class="avatar"><i class="fas fa-robot"></i></div><div><div class="bubble"><div class="typing-indicator"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div></div></div></div>`;
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
            
            setTimeout(() => {
                const typing = document.getElementById(typingId);
                if (typing) typing.remove();
                messagesDiv.innerHTML += `<div class="message assistant"><div class="avatar"><i class="fas fa-robot"></i></div><div><div class="bubble">I received your message: "${message}". Processing with my 54 tools and 58 cognitive modules.</div><div class="tools-used"><span class="tool-tag">AgentLoop</span><span class="tool-tag">IntelligentRouter</span></div></div></div>`;
                messagesDiv.scrollTop = messagesDiv.scrollHeight;
            }, 1500);
        }

        // ── Populate Grids ──────────────────────────────
        const modules = [
            { name: 'AgentLoop', icon: '🔄', desc: 'Core agent loop', cat: 'core' },
            { name: 'IntelligentRouter', icon: '🧠', desc: 'Model routing', cat: 'core' },
            { name: 'ContextCompactor', icon: '📦', desc: 'Context compression', cat: 'core' },
            { name: 'DAGScheduler', icon: '📊', desc: 'DAG execution', cat: 'core' },
            { name: 'ProviderHealthChecker', icon: '💓', desc: 'Provider health', cat: 'core' },
            { name: 'APIKeyRotation', icon: '🔑', desc: 'Key rotation', cat: 'core' },
            { name: 'QuotaManager', icon: '📋', desc: 'Quota management', cat: 'core' },
            { name: 'MemoryEngine', icon: '💾', desc: '8 memory types', cat: 'memory' },
            { name: 'CrossSessionMemory', icon: '🔗', desc: 'Cross-session', cat: 'memory' },
            { name: 'ExperienceReplay', icon: '🔁', desc: 'Experience replay', cat: 'memory' },
            { name: 'RAGEngine', icon: '📚', desc: 'RAG retrieval', cat: 'memory' },
            { name: 'HybridSearch', icon: '🔍', desc: 'Hybrid search', cat: 'memory' },
            { name: 'AdaptiveRAG', icon: '🎯', desc: 'Adaptive RAG', cat: 'memory' },
            { name: 'LearningEngine', icon: '📖', desc: 'Learning system', cat: 'learning' },
            { name: 'LoopDetector', icon: '🔁', desc: 'Loop detection', cat: 'learning' },
            { name: 'RootCauseAnalyzer', icon: '🔍', desc: 'Root cause', cat: 'learning' },
            { name: 'LessonEngine', icon: '📝', desc: 'Lesson extraction', cat: 'learning' },
            { name: 'FactChecker', icon: '✅', desc: 'Fact verification', cat: 'learning' },
            { name: 'SourceEvaluator', icon: '📰', desc: 'Source evaluation', cat: 'learning' },
            { name: 'ModelPipeline', icon: '🔗', desc: 'Multi-model pipeline', cat: 'core' },
            { name: 'WorkspaceManager', icon: '📁', desc: 'Workspaces', cat: 'core' },
            { name: 'DistributedTracer', icon: '📡', desc: 'Tracing', cat: 'core' },
            { name: 'ModelEvaluator', icon: '📊', desc: 'Model evaluation', cat: 'learning' },
            { name: 'RAGEvaluator', icon: '📈', desc: 'RAG evaluation', cat: 'learning' },
            { name: 'PeerReviewer', icon: '👥', desc: 'Peer review', cat: 'learning' },
            { name: 'AccessibilityTree', icon: '🌳', desc: 'A11y tree', cat: 'core' },
            { name: 'GhostDetector', icon: '👻', desc: 'Ghost detection', cat: 'learning' },
            { name: 'DuplicateDetector', icon: '📋', desc: 'Duplicate detection', cat: 'learning' },
            { name: 'MicroVMManager', icon: '🖥️', desc: 'MicroVM', cat: 'core' },
            { name: 'RemoteExecutor', icon: '🌐', desc: 'Remote execution', cat: 'core' },
            { name: 'PromptManager', icon: '💬', desc: 'Prompt engineering', cat: 'core' },
            { name: 'ContextualRetriever', icon: '🎯', desc: 'Contextual retrieval', cat: 'memory' },
            { name: 'NewsEngine', icon: '📰', desc: 'News aggregation', cat: 'core' },
            { name: 'EditorialAnalyzer', icon: '📊', desc: 'Editorial analysis', cat: 'core' },
            { name: 'GPUManager', icon: '🎮', desc: 'GPU management', cat: 'core' },
            { name: 'BenchmarkSuite', icon: '🏆', desc: 'Benchmarking', cat: 'learning' },
            { name: 'CodebaseForensics', icon: '🔍', desc: 'Codebase forensics', cat: 'learning' },
        ];

        function renderModules(filter = 'all') {
            const grid = document.getElementById('modulesGrid');
            const filtered = filter === 'all' ? modules : modules.filter(m => m.cat === filter);
            grid.innerHTML = filtered.map(m => `
                <div class="tool-card" onclick="showToast('info', 'Opening ${m.name}...')">
                    <div class="tool-icon">${m.icon}</div>
                    <div class="tool-name">${m.name}</div>
                    <div class="tool-desc">${m.desc}</div>
                </div>
            `).join('');
        }

        function filterModules(filter, el) {
            document.querySelectorAll('.tabs .tab').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
            renderModules(filter);
        }

        // ── Tools Grid ──────────────────────────────────
        const tools = [
            { name: 'read_file', icon: '📄', desc: 'Read file contents' },
            { name: 'write_file', icon: '✏️', desc: 'Write file contents' },
            { name: 'edit_file', icon: '🔧', desc: 'Edit by replacement' },
            { name: 'list_directory', icon: '📁', desc: 'List directory' },
            { name: 'execute_command', icon: '⚡', desc: 'Run shell commands' },
            { name: 'grep', icon: '🔍', desc: 'Search in files' },
            { name: 'glob', icon: '🌐', desc: 'Find files by pattern' },
            { name: 'git_integration', icon: '📦', desc: 'Git operations' },
            { name: 'code_executor', icon: '💻', desc: 'Execute code' },
            { name: 'browser_manager', icon: '🌍', desc: 'Web browsing' },
            { name: 'computer_use', icon: '🖥️', desc: 'Vision + Actions' },
            { name: 'docker_sandbox', icon: '🐳', desc: 'Container execution' },
            { name: 'web_scraper', icon: '🕸️', desc: 'Scrape web pages' },
            { name: 'email_manager', icon: '📧', desc: 'IMAP/SMTP email' },
            { name: 'calendar_manager', icon: '📅', desc: 'CalDAV calendar' },
            { name: 'drive_manager', icon: '💾', desc: 'WebDAV files' },
            { name: 'social_scraper', icon: '📱', desc: 'Social media' },
            { name: 'rss_aggregator', icon: '📰', desc: 'RSS/Atom feeds' },
            { name: 'image_generator', icon: '🎨', desc: 'Image generation' },
            { name: 'tts_manager', icon: '🔊', desc: 'Text to speech' },
            { name: 'stt_manager', icon: '🎤', desc: 'Speech to text' },
            { name: 'video_generator', icon: '🎬', desc: 'Video generation' },
            { name: 'presentation_generator', icon: '📊', desc: 'Presentations' },
            { name: 'website_generator', icon: '🌐', desc: 'Website generation' },
            { name: 'diagram_generator', icon: '📐', desc: 'Diagrams' },
            { name: 'backup_manager', icon: '💾', desc: 'Backup system' },
            { name: 'git_integration', icon: '📦', desc: 'Git operations' },
            { name: 'health_dashboard', icon: '💓', desc: 'Health monitoring' },
            { name: 'webhook_manager', icon: '🔔', desc: 'Webhooks' },
            { name: 'queue_manager', icon: '📋', desc: 'Job queue' },
            { name: 'log_manager', icon: '📝', desc: 'Logging' },
            { name: 'metrics_collector', icon: '📈', desc: 'Metrics' },
            { name: 'clipboard_manager', icon: '📋', desc: 'Clipboard' },
            { name: 'rate_limiter', icon: '⏱️', desc: 'Rate limiting' },
            { name: 'cache_manager', icon: '💾', desc: 'Caching' },
            { name: 'alert_manager', icon: '🔔', desc: 'Alerts' },
        ];

        function renderTools() {
            const grid = document.getElementById('toolsGrid');
            grid.innerHTML = tools.map(t => `
                <div class="tool-card" onclick="showToast('info', 'Tool: ${t.name}')">
                    <div class="tool-icon">${t.icon}</div>
                    <div class="tool-name">${t.name}</div>
                    <div class="tool-desc">${t.desc}</div>
                </div>
            `).join('');
        }

        // ── Initialize ──────────────────────────────────
        renderModules();
        renderTools();
        showToast('success', 'Dashboard loaded successfully');
    </script>
</body>
</html>
