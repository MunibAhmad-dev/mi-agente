                            <div class="card-body">
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Working Memory</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Episodic Memory</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Semantic Memory</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Procedural Memory</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Long-term Memory</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">User Preferences</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Cross-Session Memory</span></div><span class="tag green">Active</span></div>
                                <div class="status-item"><div class="left"><span class="status-dot green"></span><span class="name">Experience Replay</span></div><span class="tag green">Active</span></div>
                            </div>
                        </div>
                        <div class="card">
