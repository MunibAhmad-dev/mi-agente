# Copiar a .env y ajustar. Los SECRETOS (password de mi-opencode, API key
# del bridge) NO van acá — van en secrets/*.txt (ver secrets/*.example y
# el comentario al inicio de docker-compose.yml).

# Dónde está el checkout de mi-opencode relativo a esta carpeta
# (mi-libre-chat/integrations/opencode-bridge/). Por defecto asume que
# mi-opencode es un hermano directo de mi-libre-chat:
#   algún-directorio/
#     mi-opencode/
#     mi-libre-chat/
# Si tu layout es distinto, ajustá esta ruta (relativa a esta carpeta) o
# usá una ruta absoluta.
OPENCODE_BUILD_CONTEXT=../../../mi-opencode

# Puerto publicado en el HOST para mi-opencode (debug/curl directo).
OPENCODE_HOST_PORT=4096

# Puerto publicado en el HOST para el bridge. Este es el que usás en
# librechat.yaml como http://host.docker.internal:${BRIDGE_HOST_PORT}/v1
BRIDGE_HOST_PORT=8787

# Model ID que el bridge reporta a LibreChat vía /v1/models
BRIDGE_MODEL_ID=mi-opencode-agent
