# LiteLLM Gateway - Environment Variables
# ================================================
# Copiar este archivo a .env y completar con tus API keys

# ===============================
# LiteLLM Master Key (REQUERIDO)
# ===============================
# Clave maestra para acceder al proxy
LITELLM_MASTER_KEY=sk-your-master-key-here
LITELLM_ADMIN_KEY=sk-your-admin-key-here

# ===============================
# Base de Datos
# ===============================
POSTGRES_DB=litellm_db
POSTGRES_USER=litellm
POSTGRES_PASSWORD=your-secure-password
DATABASE_URL=postgresql://litellm:your-secure-password@localhost:5432/litellm_db

# ===============================
# Redis
# ===============================
REDIS_URL=redis://localhost:6379

# ===============================
# OPENAI
# ===============================
OPENAI_API_KEY=sk-your-openai-key

# ===============================
# ANTHROPIC (Claude)
# ===============================
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ===============================
# GOOGLE (Gemini)
# ===============================
GOOGLE_API_KEY=your-google-api-key

# ===============================
# GROQ (Gratis, rápido)
# ===============================
GROQ_API_KEY=gsk_your-groq-key

# ===============================
# MISTRAL
# ===============================
MISTRAL_API_KEY=your-mistral-key

# ===============================
# DEEPSEEK (Económico)
# ===============================
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ===============================
# COHERE
# ===============================
COHERE_API_KEY=your-cohere-key

# ===============================
# TOGETHER AI
# ===============================
TOGETHER_API_KEY=your-together-key

# ===============================
# NVIDIA NIM
# ===============================
NVIDIA_API_KEY=your-nvidia-api-key

# ===============================
# PERPLEXITY
# ===============================
PERPLEXITY_API_KEY=pplx-your-perplexity-key

# ===============================
# UI
# ===============================
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=admin123

# ===============================
# GRAFANA (Opcional)
# ===============================
GRAFANA_PASSWORD=admin123

# ===============================
# OTEL (OpenTelemetry, opcional)
# ===============================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ===============================
# SLACK (Alertas, opcional)
# ===============================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
