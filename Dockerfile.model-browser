FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json ./

# Install dependencies
RUN npm install --production

# Copy service files
COPY api/server/services/AIModelBrowser/ ./api/server/services/AIModelBrowser/

# Expose port
EXPOSE 3456

# Start the model browser
CMD ["node", "api/server/services/AIModelBrowser/index.js"]
