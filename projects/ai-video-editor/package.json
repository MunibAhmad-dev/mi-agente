{
  "name": "ai-creative-os",
  "version": "0.1.0",
  "description": "AI Creative OS - Universal Local-First Creative Automation Platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-creative-os": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "gui:dev": "cd gui && npx vite",
    "gui:build": "cd gui && npx vite build",
    "electron:dev": "cd gui && npx vite & sleep 2 && npx tsc -p tsconfig.electron.json && electron electron/dist/main.js",
    "electron:build": "cd gui && npx vite build && npx tsc -p tsconfig.electron.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^10.3.0",
    "js-yaml": "^4.1.0",
    "nanoid": "^5.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
