{
  "name": "creative-ai-orchestrator",
  "version": "0.1.0",
  "description": "Universal Creative AI Orchestrator - Discover, install, configure, execute, evaluate and improve AI creative tools autonomously",
  "main": "electron/main.ts",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:unit": "node --import tsx --test src/**/*.test.ts --grep",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:build": "tsc && electron-builder",
    "electron:build:win": "tsc && electron-builder --win",
    "electron:build:mac": "tsc && electron-builder --mac",
    "electron:build:linux": "tsc && electron-builder --linux"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.11.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "glob": "^11.0.0",
    "node-fetch": "^3.3.2",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "p-throttle": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "reactflow": "^11.11.4",
    "semver": "^7.6.3",
    "sharp": "^0.35.4",
    "sql.js": "^1.11.0",
    "tar": "^7.4.0",
    "unzipper": "^0.12.3",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/semver": "^7.5.8",
    "@types/tar": "^6.1.11",
    "@types/unzipper": "^0.10.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
