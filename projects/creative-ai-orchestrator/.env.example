# Creative AI Orchestrator Configuration

# Server
PORT=3456
HOST=127.0.0.1

# LLM Provider (at least one required for agent features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Local LLM
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3

# Discovery
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
CIVITAI_API_KEY=

# ComfyUI
COMFYUI_PATH=
COMFYUI_PORT=8188

# Storage
DATA_DIR=./data
DB_PATH=./data/caio.db
MODELS_DIR=./data/models
OUTPUTS_DIR=./data/outputs
PROJECTS_DIR=./data/projects
CACHE_DIR=./data/cache

# Security
AUTONOMY_LEVEL=assisted
MAX_DOWNLOAD_SIZE_MB=4096
SANDBOX_ENABLED=true

# Telemetry (disabled by default)
TELEMETRY_ENABLED=false
