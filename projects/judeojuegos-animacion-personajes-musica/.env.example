# Universal Creative Engine — configuration (copy to .env and adjust)

# Data directory; DB, assets, and the signing secret live under it.
# UCE_DATA_DIR=./data

# Override the derived paths if you need them elsewhere.
# UCE_DB_URL=sqlite:///./data/freebuff.db
# UCE_STORAGE_ROOT=./data/assets
# UCE_SECRET_PATH=./data/.secret

# Server
# UCE_HOST=127.0.0.1
# UCE_PORT=8765

# Execution
# UCE_MAX_ATTEMPTS=2
# UCE_POLL_INTERVAL=0.2

# Logging: DEBUG | INFO | WARNING | ERROR
# UCE_LOG_LEVEL=INFO

# GPU integration is DISABLED by user decision (2026-09-07) — the system runs
# CPU-only. Do not enable until hardware + adapters are deliberately connected.
# UCE_ENABLE_GPU=false