# BRAIN Configuration
# Copy to .env and customize

# === Database ===
DATABASE_URL=postgresql://brain:brain@localhost:5432/brain
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# === Embedding ===
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# === LLM Provider ===
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# === Reranker ===
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# === Search ===
SEARCH_MAX_RESULTS=30
SEARCH_SIMILARITY_THRESHOLD=0.3
SEARCH_RRF_K=60
SEARCH_EXPANSION_ENABLED=true

# === Memory ===
MEMORY_FORGET_RETENTION_DAYS=30
MEMORY_PURGE_MIN_AGE_DAYS=90
MEMORY_DEDUP_SIMILARITY_THRESHOLD=0.95

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# === Auth ===
AUTH_TOKEN_EXPIRY_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=120

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === MCP ===
MCP_ENABLED=true
MCP_TRANSPORT=stdio

# === NLP / spaCy ===
SPACY_MODEL=en_core_web_sm
