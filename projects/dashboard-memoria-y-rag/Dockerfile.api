FROM python:3.12-slim AS base

# System deps (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create user + writable cache
RUN groupadd -r brain && useradd -r -g brain -d /app brain && \
    mkdir -p /app/.cache/huggingface /app/.cache/torch && \
    chown -R brain:brain /app/.cache

WORKDIR /app

# Install CPU-only PyTorch (smallest possible)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu --no-deps

# Install minimal deps (no scipy, no dev packages)
RUN pip install --no-cache-dir \
    "fastapi>=0.115.0" \
    "uvicorn[standard]>=0.30.0" \
    "psycopg[binary]>=3.2.0" \
    "psycopg-pool>=3.2.0" \
    "pgvector>=0.3.0" \
    "sentence-transformers>=3.0.0" \
    "httpx>=0.27.0" \
    "structlog>=24.1.0" \
    "pydantic>=2.8.0" \
    "pydantic-settings>=2.4.0" \
    "python-dotenv>=1.0.0" \
    "aiofiles>=24.1.0" \
    "python-multipart>=0.0.9" \
    "python-dateutil>=2.9.0" \
    "bcrypt>=4.1.0" \
    "onnxruntime>=1.17.0" \
    "optimum>=1.17.0" \
    "spacy>=3.7.0" && \
    # Remove pip cache
    rm -rf /root/.cache/pip /tmp/* || true

# Copy scripts first for ONNX conversion
COPY scripts/ scripts/

# Download spaCy model + embedding model at build time
RUN python -m spacy download en_core_web_sm 2>/dev/null || true
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')" 2>/dev/null || true

# Pre-convert to ONNX at build time
RUN python scripts/convert_to_onnx.py 2>/dev/null || true

# Copy source
COPY src/ src/

# Environment
ENV PYTHONPATH=/app/src
ENV HF_HOME=/app/.cache/huggingface
ENV TORCH_HOME=/app/.cache/torch
ENV TRANSFORMERS_CACHE=/app/.cache/huggingface
ENV TOKENIZERS_PARALLELISM=false
ENV OMP_NUM_THREADS=2
ENV MKL_NUM_THREADS=2

USER brain

EXPOSE 8000

# Single worker, no reload, minimal memory
CMD ["python", "-m", "uvicorn", "brain.api.app:create_app", \
     "--factory", "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--loop", "uvloop", "--http", "httptools"]
