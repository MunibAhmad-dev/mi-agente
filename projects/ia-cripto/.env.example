# AEOS environment template (spec §152). Copy to .env and adjust.
# NEVER commit real credentials. Modes: development|test|paper|shadow|limited_live|production

AEOS_MODE=paper
AEOS_DATA_DIR=./data
# AEOS_DB_PATH=./data/aeos.db

# Treasury policy (§17)
AEOS_RESERVE_FLOOR=0.30
AEOS_MAX_EXPERIMENT_BUDGET=0.10
AEOS_MAX_BUSINESS_ALLOCATION=0.40
AEOS_MAX_INVESTMENT_ALLOCATION=0.35

# Risk limits (§51)
AEOS_MAX_POSITION_PCT=0.10
AEOS_MAX_DAILY_LOSS_PCT=0.05
AEOS_MAX_DRAWDOWN_PCT=0.20
AEOS_MAX_FEE_BPS=50
AEOS_MAX_SLIPPAGE_BPS=100

# Agents (§119)
AEOS_MAX_POPULATION=64

# --- External credentials (all optional; the system reports what it lacks) ---
# Exchange (trade-only keys, withdrawal disabled; required only for limited_live)
# AEOS_EXCHANGE_API_KEY=
# AEOS_EXCHANGE_API_SECRET=
# AEOS_EXCHANGE_NAME=binance

# Payments (Phase 3+; Stripe test keys first)
# AEOS_STRIPE_SECRET_KEY=
# AEOS_STRIPE_WEBHOOK_SECRET=
